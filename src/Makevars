CXX_STD = CXX14
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

### Dynamic CUDA Path Discovery
ifeq ($(CUDA_HOME),)
  CUDA_HOME := /usr/local/cuda
endif
CUDA_INC = $(CUDA_HOME)/include

### R and Package Includes
RCPP_INC = $(shell Rscript -e "cat(system.file('include', package='Rcpp'))")
ARMA_INC = $(shell Rscript -e "cat(system.file('include', package='RcppArmadillo'))")
MATRIX_INC = $(shell Rscript -e "cat(system.file('include', package='Matrix'))")

### Standard C++ Compilation (No NVCC needed!)
PKG_CPPFLAGS = -I"$(CUDA_INC)" -I"$(RCPP_INC)" -I"$(ARMA_INC)" -I"$(MATRIX_INC)"

### Libraries (Link CUDA APIs)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) \
           -L"$(CUDA_HOME)/lib64" -Wl,-rpath,"$(CUDA_HOME)/lib64" -lcudart -lcublas -lcusolver -lcusparse